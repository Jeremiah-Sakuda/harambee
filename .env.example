PORT=3101
HOST=127.0.0.1
# Local fixture mode uses no credentials or real money.
# Optional live model interpretation; payment amounts still come from code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional integrated group sandbox and diagnostic adapter; never use live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional sandbox webhook (docs/SANDBOX_TESTING.md). The ID of the webhook registered on
# this sandbox app; POST /api/paypal/webhook verifies every delivery with PayPal against it
# and only then reconciles. Unset: the route answers 503 and does nothing.
# PAYPAL_WEBHOOK_ID=
# Optional operator payee (a sandbox business account email) added to each order's
# purchase_units[0].payee. UNTESTED in sandbox: PayPal may refuse a payee on an
# AUTHORIZE order without partner approval. Unset: orders are paid to this app's merchant.
# PAYPAL_PAYEE_EMAIL=
# Where PayPal returns buyers if the browser sends no Origin (defaults to this server).
# APP_URL=http://127.0.0.1:5171

# Optional isolated sandbox evidence file (default data/sandbox-lab.json)
# SANDBOX_DATA_FILE=/tmp/harambee-sandbox.json
