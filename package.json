{
  "name": "harambee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node server/index.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5171",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:sandbox": "node --test test/sandbox.test.mjs test/group-payments.test.mjs test/sandbox-matrix.test.mjs",
    "sandbox:simulate": "node scripts/simulate-sandbox.mjs",
    "sandbox:live": "node scripts/test-paypal-sandbox.mjs",
    "eval": "node scripts/evaluate.mjs && node scripts/evaluate-revisions.mjs >/dev/null && node scripts/evaluate-revisions.mjs --holdout >/dev/null && node scripts/evaluate-revisions.mjs --holdout2 >/dev/null",
    "eval:live": "node --env-file-if-exists=.env scripts/evaluate.mjs --live",
    "paypal:check": "node scripts/paypal-check.mjs",
    "eval:revisions": "node scripts/evaluate-revisions.mjs",
    "eval:revisions:live": "node --env-file-if-exists=.env scripts/evaluate-revisions.mjs --live"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
